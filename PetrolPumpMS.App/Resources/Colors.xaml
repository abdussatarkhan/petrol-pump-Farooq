<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral surface scale -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F4F6F8</Color>
    <Color x:Key="SidebarColor">#1C2536</Color>
    <Color x:Key="SidebarHoverColor">#28334A</Color>
    <Color x:Key="BorderColor">#E1E5EA</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1A2233</Color>
    <Color x:Key="TextSecondaryColor">#5C6B7A</Color>
    <Color x:Key="TextOnDarkColor">#F2F5F9</Color>
    <Color x:Key="TextOnDarkMutedColor">#9AA7BD</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentSoftColor">#E8EFFD</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="SuccessSoftColor">#E5F6EA</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="WarningSoftColor">#FDF0E1</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="DangerSoftColor">#FBE7E7</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />
    <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

</ResourceDictionary>
