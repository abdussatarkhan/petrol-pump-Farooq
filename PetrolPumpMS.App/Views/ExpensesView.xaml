<UserControl x:Class="PetrolPumpMS.App.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Expenses" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Log Expense" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,14" />
                    <TextBlock Text="Date" Style="{StaticResource FieldLabelText}" />
                    <DatePicker SelectedDate="{Binding FormDate}" Margin="0,0,0,12" />
                    <TextBlock Text="Category" Style="{StaticResource FieldLabelText}" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Categories}" SelectedItem="{Binding FormCategory}" Margin="0,0,0,12" />
                    <TextBlock Text="Description" Style="{StaticResource FieldLabelText}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
                    <TextBlock Text="Amount" Style="{StaticResource FieldLabelText}" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,0,0,10" />

                    <Button Content="Add Expense" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,44,0,0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Expenses}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="90" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}Rs. {0:N2}}" Width="110" />
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
