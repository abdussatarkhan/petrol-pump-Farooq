<Window x:Class="PetrolPumpMS.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PetrolPumpMS.App.Converters"
        Style="{StaticResource AppWindow}"
        Title="Petrol Pump Management System — Sign in"
        Height="520" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="ErrorVisConverter" />
        <conv:BoolToVisibilityConverter x:Key="BusyVisConverter" />
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource Card}" Margin="32" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="{StaticResource AccentBrush}" Width="56" Height="56" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⛽" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Petrol Pump Management" Style="{StaticResource PageTitleText}" HorizontalAlignment="Center" FontSize="20" />
                <TextBlock Text="Sign in to continue" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <TextBlock Text="Username" Style="{StaticResource FieldLabelText}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource AppTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabelText}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,6"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationErrorText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource ErrorVisConverter}}" />

                <Button Content="Sign In" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                        Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <TextBlock Text="Signing in..." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BusyVisConverter}}" />

                <TextBlock Text="Default admin login: admin / Admin@123 (change after first sign-in)"
                           Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
