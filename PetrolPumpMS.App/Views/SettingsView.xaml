<UserControl x:Class="PetrolPumpMS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Change password -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Change Password" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,14" />
                            <TextBlock Text="Current Password" Style="{StaticResource FieldLabelText}" />
                            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,12" PasswordChanged="CurrentPasswordBox_PasswordChanged" />
                            <TextBlock Text="New Password" Style="{StaticResource FieldLabelText}" />
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,12" PasswordChanged="NewPasswordBox_PasswordChanged" />
                            <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabelText}" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,16" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationErrorText}"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PasswordMessage}" Style="{StaticResource CaptionText}" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding PasswordMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,0,0,8" />

                            <Button Content="Update Password" Style="{StaticResource PrimaryButton}" Command="{Binding ChangePasswordCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Backup -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Database Backup" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,10" />
                            <TextBlock Text="Runs pg_dump and saves a .backup file to a folder you choose. Requires PostgreSQL client tools on PATH."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <TextBlock Text="{Binding BackupMessage}" Style="{StaticResource CaptionText}" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding BackupMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Content="Backup Database" Style="{StaticResource SecondaryButton}" Command="{Binding BackupDatabaseCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- User management (Admin only) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="User Accounts" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                <TextBlock Text="Full Name" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NewUserFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Temp Password" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                <TextBlock Text="Role" Style="{StaticResource FieldLabelText}" />
                                <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Roles}" SelectedItem="{Binding NewUserRole}" Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Create User" Style="{StaticResource PrimaryButton}" Command="{Binding CreateUserCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Users}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SuccessBadge}">
                                                <TextBlock Text="{Binding Active, Converter={StaticResource BoolToActiveTextConverter}}"
                                                           Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Toggle Active" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
