<UserControl x:Class="PetrolPumpMS.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <TextBlock Text="Reports" Style="{StaticResource PageTitleText}" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="From" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Margin="0,0,12,0" />
                    <TextBlock Text="To" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding DateTo}" Width="130" Margin="0,0,12,0" />
                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Margin="0,0,0,10" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Daily Sales Trend" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />
                    <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" Height="260" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sales by Fuel Type" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />
                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding FuelSummary}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fuel" Binding="{Binding FuelName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity, StringFormat={}{0:N0}}" Width="70" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}Rs. {0:N0}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sales by Payment Mode" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />
                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding PaymentSummary}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mode" Binding="{Binding PaymentMode}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}Rs. {0:N0}}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Employee Performance" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />
                        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding EmployeeSummary}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity, StringFormat={}{0:N0}}" Width="60" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat={}Rs. {0:N0}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
